{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nunomaduro/laravel-starter-kit-inertia-react",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5.0",
        "inertiajs/inertia-laravel": "^3.0.0-beta",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.16.1",
        "laravel/wayfinder": "^0.1.20",
        "nunomaduro/essentials": "^1.2.0",
        "nunomaduro/laravel-optimize-database": "^1.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5.0",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.10.0",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.29.3",
        "laravel/tinker": "^3.0.2",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.4",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "rector/rector": "^2.4.5",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "bun install",
            "bun run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bun run dev"
        ],
        "dev:full": [
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#c4b5fd,#fb7185,#fdba74\" \"bunx varlock run -- php artisan queue:listen --tries=1\" \"bunx varlock run -- php artisan pail --timeout=0\" \"bun run dev\" --names=queue,logs,vite --kill-others"
        ],
        "queue": "bunx varlock run -- php artisan queue:listen --tries=1",
        "logs": "bunx varlock run -- php artisan pail --timeout=0",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan clear"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "upgrade:requirements": [
            "composer bump",
            "bunx npm-check-updates -u"
        ],
        "lint": [
            "rector",
            "pint --parallel",
            "bun run lint"
        ],
        "test:type-coverage": "php -d memory_limit=512M vendor/bin/pest --type-coverage --min=100",
        "test:app": "php artisan test tests/Unit tests/Feature --compact --do-not-cache-result",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run",
            "bun run test:lint"
        ],
        "test:lint:ci": [
            "pint --parallel --test",
            "rector --dry-run",
            "bun run test:lint:ci"
        ],
        "test:browser": "pest tests/Browser --parallel --processes=2 --compact",
        "test:unit": "XDEBUG_MODE=\"coverage\" pest --parallel --testsuite=Unit,Feature --coverage --exactly=100.0",
        "test:types": [
            "phpstan --memory-limit=512M",
            "bun run test:types"
        ],
        "test:types:ci": [
            "phpstan --memory-limit=512M",
            "bun run test:types:ci"
        ],
        "test": [
            "@test:type-coverage",
            "@test:unit",
            "@test:lint",
            "@test:types",
            "@test:browser"
        ],
        "test:ci": [
            "@test:type-coverage",
            "@test:unit",
            "@test:lint:ci",
            "@test:types:ci",
            "@test:browser"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
