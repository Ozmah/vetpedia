# Vetpedia environment schema.
# Safe to commit: describes configuration, never plaintext secrets.
#
# Operational command model:
# - Run Varlock encryption and Docker Compose orchestration from the Linux host.
#   Examples: `bunx varlock encrypt --file .env` and
#   `bunx varlock run -- docker compose up -d --build --remove-orphans`.
# - Any host command that invokes `docker compose` must be wrapped with
#   `bunx varlock run -- ...` so Compose receives decrypted values instead of
#   literal `varlock("local:...")` resolver strings.
# - Run application tooling inside the container after Compose has injected the
#   resolved environment: Composer, Artisan, Pest, Pint, Rector, PHPStan, Vite+,
#   and regular `bun run ...` project commands.
# - Run `varlock scan` on the Linux host. The host scan respects gitignore for
#   local runtime files such as `.env`; container scans may inspect ignored
#   bind-mounted files and produce false positives.
# - Do not run `varlock encrypt` inside the container. Encryption belongs to the
#   host trust boundary; the container should consume already-resolved env vars.
#
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# @currentEnv=$INFISICAL_ENV
# @plugin(@varlock/infisical-plugin)
# @initInfisical(
#   projectId=$INFISICAL_PROJECT_ID,
#   environment=$INFISICAL_ENV,
#   clientId=$INFISICAL_CLIENT_ID,
#   clientSecret=$INFISICAL_CLIENT_SECRET
# )
# ---

# -----------------------------------------------------------------------------
# Infisical bootstrap
# -----------------------------------------------------------------------------

# Infisical environment slug to read secrets from.
# @type=enum(local, dev, production)
INFISICAL_ENV=local

# Infisical project ID. Store encrypted in local .env.
# @required @sensitive
INFISICAL_PROJECT_ID=

# Infisical Machine Identity client ID. Store encrypted in local .env.
# @required @type=infisicalClientId @sensitive
INFISICAL_CLIENT_ID=

# Infisical Machine Identity client secret. Store encrypted in local .env.
# @required @type=infisicalClientSecret @sensitive
INFISICAL_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

APP_NAME=Vetpedia

# Laravel runtime environment follows the Infisical environment slug.
# @type=enum(local, dev, production)
APP_ENV=$INFISICAL_ENV

# Laravel encryption key. Must be stable per environment.
# @required @sensitive
APP_KEY=infisical()

# @type=boolean
APP_DEBUG=ifs(eq($APP_ENV, production), false, true)

# Public application URL.
# @type=url
APP_URL=https://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# @type=number
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Local Docker user mapping
# -----------------------------------------------------------------------------

# @type=number
HOST_UID=1000

# @type=number
HOST_GID=1000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=ifs(eq($APP_ENV, production), warning, debug)

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

DB_CONNECTION=sqlite
DB_DATABASE=/app-data/vetpedia.sqlite

SESSION_DRIVER=database

# @type=number
SESSION_LIFETIME=120

# @type=boolean
SESSION_ENCRYPT=false

SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null

# @type=number
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1

# @type=number
MAIL_PORT=2525

MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=$APP_NAME

# -----------------------------------------------------------------------------
# Public frontend values
# -----------------------------------------------------------------------------

VITE_APP_NAME=$APP_NAME

# @type=url
VITE_SITE_URL=$APP_URL

# @type=boolean
VITE_NO_INDEX=ifs(eq($APP_ENV, production), false, true)

# -----------------------------------------------------------------------------
# Vetpedia feature flags
# -----------------------------------------------------------------------------

# Allows development/debug search to include unapproved entries.
# Search code must also fail closed.
# @type=boolean
VETPEDIA_ALLOW_UNAPPROVED_SEARCH=false

# Initial seeded users. Values are stored under the /seed-users path in Infisical.
# @required @sensitive
VETPEDIA_SUPERADMIN_NAME=infisical(_default, "VETPEDIA_SUPERADMIN_NAME", "/seed-users")

# @required @sensitive @type=email
VETPEDIA_SUPERADMIN_EMAIL=infisical(_default, "VETPEDIA_SUPERADMIN_EMAIL", "/seed-users")

# @required @sensitive
VETPEDIA_SUPERADMIN_PASSWORD=infisical(_default, "VETPEDIA_SUPERADMIN_PASSWORD", "/seed-users")

# @required @sensitive
VETPEDIA_ADMIN_NAME=infisical(_default, "VETPEDIA_ADMIN_NAME", "/seed-users")

# @required @sensitive @type=email
VETPEDIA_ADMIN_EMAIL=infisical(_default, "VETPEDIA_ADMIN_EMAIL", "/seed-users")

# @required @sensitive
VETPEDIA_ADMIN_PASSWORD=infisical(_default, "VETPEDIA_ADMIN_PASSWORD", "/seed-users")

# Local/development dummy account password. Dummy users are not seeded in production.
# @required @sensitive
VETPEDIA_DUMMY_USER_PASSWORD=infisical(_default, "VETPEDIA_DUMMY_USER_PASSWORD", "/seed-users")

# -----------------------------------------------------------------------------
# Search
# -----------------------------------------------------------------------------

SCOUT_DRIVER=database

# Shared Typesense key for local development. Override via Infisical later if needed.
TYPESENSE_API_KEY=ifs(eq($APP_ENV, production), infisical(), local-development-typesense-key)

TYPESENSE_HOST=typesense

# @type=number
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
