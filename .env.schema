# Vetpedia environment schema
# This file is safe to commit: it describes configuration, but does not store
# plaintext secrets.
#
# @defaultRequired=infer @defaultSensitive=false
# @currentEnv=$APP_ENV
# @plugin(@varlock/infisical-plugin)
# @initInfisical(
#   projectId=$INFISICAL_PROJECT_ID,
#   environment=$APP_ENV,
#   clientId=$INFISICAL_CLIENT_ID,
#   clientSecret=$INFISICAL_CLIENT_SECRET
# )
# ---

# -----------------------------------------------------------------------------
# Infisical bootstrap
# -----------------------------------------------------------------------------

# Infisical project ID. Configure directly in local/container env.
# @required
INFISICAL_PROJECT_ID=

# Infisical Machine Identity client ID. Configure directly in local/container env.
# @required @type=infisicalClientId
INFISICAL_CLIENT_ID=

# Infisical Machine Identity client secret. Configure directly in local/container env.
# @required @type=infisicalClientSecret @sensitive
INFISICAL_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

APP_NAME=Vetpedia

# Laravel runtime environment and Infisical environment slug.
# @type=enum(local, development, production)
APP_ENV=local

# Laravel encryption key. Must be stable per environment.
# @required @sensitive
APP_KEY=infisical()

# @type=boolean
APP_DEBUG=if(forEnv(production), false, true)

# Public application URL for URL generation.
# @type=url
APP_URL=if(forEnv(local), https://localhost:8000, infisical())

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# @type=number
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

DB_CONNECTION=sqlite
DB_DATABASE=/app/database/vetpedial.sqlite

SESSION_DRIVER=database

# @type=number
SESSION_LIFETIME=120

# @type=boolean
SESSION_ENCRYPT=false

SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null

# @type=number
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1

# @type=number
MAIL_PORT=2525

MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=$APP_NAME

# -----------------------------------------------------------------------------
# Public frontend values
# -----------------------------------------------------------------------------

VITE_APP_NAME=$APP_NAME

# @type=url
VITE_SITE_URL=$APP_URL

# @type=boolean
VITE_NO_INDEX=true

# -----------------------------------------------------------------------------
# Vetpedia feature flags
# -----------------------------------------------------------------------------

# Allows development/debug search to include unapproved entries.
# Production code must ignore this when APP_ENV=production.
# @type=boolean
VETPEDIA_ALLOW_UNAPPROVED_SEARCH=false

# -----------------------------------------------------------------------------
# Search
# -----------------------------------------------------------------------------

SCOUT_DRIVER=database

# Shared Typesense key for local development. Override via Infisical later if needed.
# @sensitive
TYPESENSE_API_KEY=if(forEnv(production), infisical(), local-development-typesense-key)

TYPESENSE_HOST=typesense

# @type=number
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
